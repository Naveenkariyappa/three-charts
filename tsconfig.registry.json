{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "public/registry/ts/*.ts",
    "public/registry/ts/single/*.ts",
    "public/registry/react-ts/*.ts",
    "public/registry/react-ts/*.tsx",
    "public/registry/react-ts/single/*.tsx"
  ]
}
